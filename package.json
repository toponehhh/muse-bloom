{
  "name": "muse-bloom",
  "version": "1.1.1",
  "private": true,
  "description": "A buildless dress-up puzzle game with 36 challenges and 122 collectible pieces.",
  "scripts": {
    "start": "node dev/server.js",
    "test": "node dev/game.test.js && node dev/validate.js",
    "validate": "node dev/validate.js",
    "assets": "node dev/export-assets.js && node dev/embed-assets.js",
    "embed-assets": "node dev/embed-assets.js",
    "test:browser": "node dev/browser.test.js",
    "standalone": "node dev/standalone.js",
    "test:accessories": "node dev/accessory.test.js",
    "test:ui": "node dev/standalone.js && node dev/accessory.test.js && node dev/ui.test.js",
    "test:ui:update": "node dev/standalone.js && node dev/ui.test.js --update-baselines",
    "package": "node dev/package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
