{
  "name": "muse-bloom",
  "version": "1.7.0",
  "private": true,
  "description": "A buildless dress-up puzzle game with 36 challenges and 122 collectible pieces.",
  "scripts": {
    "start": "node dev/server.js",
    "test": "node dev/game.test.js && node dev/edit.test.js && node dev/validate.js",
    "validate": "node dev/validate.js",
    "assets": "node dev/export-assets.js && node dev/embed-assets.js",
    "embed-assets": "node dev/embed-assets.js",
    "test:browser": "node dev/salon.test.js",
    "test:lookbook": "node dev/lookbook.test.js",
    "test:experience": "node dev/experience.test.js",
    "standalone": "node dev/standalone.js",
    "package:upload": "node dev/standalone.js dist/crazygames-upload/index.html",
    "test:upload": "npm run package:upload && node dev/upload.test.js",
    "test:accessories": "node dev/salon.test.js",
    "test:anatomy": "node dev/fitting.test.js",
    "test:ui": "node dev/salon.test.js",
    "package": "node dev/package.js",
    "test:glam": "node dev/glam.test.js",
    "test:characters": "node dev/salon.test.js",
    "test:fitting": "node dev/fitting.test.js",
    "test:neckline": "node dev/neckline.test.js",
    "test:edit": "node dev/edit.test.js",
    "assets:capsule": "node dev/build-capsule.js && node dev/embed-assets.js",
    "package:playtest": "node dev/package-playtest.js",
    "test:playtest": "node dev/package-playtest.js && node dev/playtest.test.js",
    "playtest:summary": "node dev/summarize-playtest.js",
    "package:pages": "node dev/package-pages.js",
    "test:pages": "npm run package:pages && node dev/pages.test.js",
    "package:cloudflare": "node dev/package-cloudflare.js",
    "test:feedback-api": "node dev/feedback-api.test.js && node dev/feedback-migration.test.js",
    "test:feedback-kind": "node dev/feedback-kind.test.js",
    "test:playtest-ui": "npm run package:cloudflare && node dev/playtest-ui.test.js",
    "test:quality": "node dev/quality.test.js",
    "test:cloudflare": "npm run package:cloudflare && node dev/cloudflare.test.js",
    "cf:dev": "npm run package:cloudflare && node dev/cloudflare-command.js dev",
    "cf:configure": "node dev/cloudflare-command.js configure",
    "cf:deploy": "npm run package:cloudflare && node dev/cloudflare-command.js deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "miniflare": "5.20261019.0-beta",
    "playwright": "1.62.1",
    "wrangler": "4.151.2"
  }
}
