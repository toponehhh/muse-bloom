{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-bloom",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "muse-bloom-feedback",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [{
    "name": "FEEDBACK_RATE_LIMIT",
    "namespace_id": "19701020",
    "simple": { "limit": 60, "period": 60 }
  }]
}
